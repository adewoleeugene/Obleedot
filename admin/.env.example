# Public Blob store for posters. Vercel adds it when you connect the store to the project.
BLOB_READ_WRITE_TOKEN=

# Private Blob store for the events file (drafts stay private). Vercel adds it when you connect the
# private store; on Vercel the app signs in to it with its built-in OIDC token, so there is no secret.
BLOB_STORE_ID=

# The passcode your team types to sign in to the admin. Use a long phrase.
ADMIN_PASSCODE=

# A long random string that signs the sign-in cookie. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Vercel sends this to the daily clean-up job. Generate one with: openssl rand -hex 32
CRON_SECRET=
