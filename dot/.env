# Public settings for the dot. Code reads each one from `env`, such as `env.API_URL`.
# They're built into the dot, so anyone who has it can read them. Never put a secret here.

# The admin app's API, such as https://salone-events-admin.vercel.app/api. Leave it empty to use
# the sample events in lib/sample-data.ts. When you set it, add its host and
# *.public.blob.vercel-storage.com to `network.hosts` in dot.json.
API_URL=

# The dot's share link base once it's registered, such as https://dashit.to/d/<code>.
# Leave it empty and sharing an event sends text only.
SHARE_URL=
