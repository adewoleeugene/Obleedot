<View gap="large">
  <Toast message="{{ toast }}" tone="{{ toastTone }}" onHide="clearToast" />

  <If condition="{{ loading }}">
    <Skeleton shape="box" height="360" />
    <Skeleton shape="text" lines="5" />
  </If>
  <ElseIf condition="{{ notFound }}">
    <EmptyState icon="calendar" title="Event not found" text="It may have ended or been taken down.">
      <Button variant="secondary" onClick="backToEvents">See what's on</Button>
    </EmptyState>
  </ElseIf>
  <ElseIf condition="{{ error }}">
    <Notice tone="danger" title="This event didn't load">{{ error }}</Notice>
    <Button variant="secondary" onClick="load">Try again</Button>
  </ElseIf>
  <ElseIf condition="{{ event }}">
    <!-- The poster is the hero, shown whole on a quiet tonal panel. -->
    <View background="surface" radius="large" padding="none">
      <Image src="{{ event.image }}" alt="Poster for {{ event.title }}" aspect="{{ posterAspect }}" fit="contain" shape="square" onLoad="posterLoaded" />
    </View>

    <View gap="small">
      <Text variant="display" weight="bold" leading="tight">{{ event.title }}</Text>
      <View direction="row" gap="small" align="center" wrap>
        <Text tone="muted">{{ event.kicker }}</Text>
        <If condition="{{ event.soldOut }}">
          <Badge tone="danger">Sold out</Badge>
        </If>
      </View>
      <Text variant="lead">{{ event.summary }}</Text>
    </View>

    <!-- When and where: the facts people come for, as hairline rows with icons. -->
    <View gap="none" border="subtle" radius="large" background="surface">
      <View direction="row" gap="medium" align="center" padding="medium">
        <Icon name="calendar" tone="muted" />
        <View gap="none" grow>
          <Text weight="medium">{{ event.dateLabel }}</Text>
          <Text variant="caption" tone="muted">{{ event.timeLabel }}</Text>
        </View>
      </View>
      <Divider />
      <View direction="row" gap="medium" align="center" padding="medium">
        <Icon name="location" tone="muted" />
        <View gap="none" grow>
          <Text weight="medium">{{ event.venue }}</Text>
          <If condition="{{ event.address }}">
            <Text variant="caption" tone="muted">{{ event.address }}</Text>
          </If>
        </View>
      </View>
      <If condition="{{ event.dressCode }}">
        <Divider />
        <View direction="row" gap="medium" align="center" padding="medium">
          <Icon name="star" tone="muted" />
          <View gap="none" grow>
            <Text weight="medium">{{ event.dressCode }}</Text>
            <Text variant="caption" tone="muted">Dress code</Text>
          </View>
        </View>
      </If>
      <Divider />
      <View direction="row" gap="medium" align="center" padding="medium">
        <Icon name="ticket" tone="muted" />
        <View gap="none" grow>
          <Text weight="medium">{{ event.priceLabel }}</Text>
          <Text variant="caption" tone="muted">Tickets aren't sold in this dot</Text>
        </View>
      </View>
    </View>

    <View gap="small">
      <Text variant="title" weight="bold">About</Text>
      <RichText markdown="{{ event.description }}" />
      <If condition="{{ event.organizer }}">
        <Text variant="caption" tone="muted">Presented by {{ event.organizer }}</Text>
      </If>
    </View>

    <If condition="{{ event.prices.length > 0 }}">
      <View gap="small">
        <Text variant="title" weight="bold">Ticket prices</Text>
        <View gap="none">
          <For each="{{ event.prices }}" item="price" index="i" key="id">
            <If condition="{{ i > 0 }}">
              <Divider />
            </If>
            <View direction="row" justify="between" align="center" gap="medium" paddingTop="medium" paddingBottom="medium">
              <View gap="none" grow>
                <Text weight="medium">{{ price.name }}</Text>
                <If condition="{{ price.detail }}">
                  <Text variant="caption" tone="muted">{{ price.detail }}</Text>
                </If>
              </View>
              <If condition="{{ price.soldOut }}">
                <Badge tone="danger">Sold out</Badge>
              </If>
              <Else>
                <Text variant="subtitle" weight="bold" numeric>{{ price.priceLabel }}</Text>
              </Else>
            </View>
          </For>
        </View>
        <Text variant="caption" tone="muted">From the organiser's poster. Prices may change.</Text>
      </View>
    </If>

    <If condition="{{ event.phone || event.website }}">
      <View gap="small">
        <Text variant="title" weight="bold">Contact</Text>
        <If condition="{{ event.phone }}">
          <Button variant="secondary" onClick="call">Call {{ event.phoneLabel }}</Button>
        </If>
        <If condition="{{ event.website }}">
          <Text><Link href="{{ event.website }}">Visit the organiser's website</Link></Text>
        </If>
      </View>
    </If>

    <!-- Share stays quiet: a plain row, so the footer's Remind me is the only accent. -->
    <View direction="row" justify="center" align="center" gap="small" paddingTop="small" paddingBottom="small" onTap="share">
      <Icon name="share" tone="muted" size="small" />
      <Text weight="medium">Share this event</Text>
    </View>

    <!-- Keep it for later: save it, and get a nudge before it starts. Gold only on Remind me, the
         one thing to do here; once a reminder is set both buttons go quiet. -->
    <Footer>
      <View direction="row" gap="small">
        <View grow>
          <Button variant="secondary" onClick="toggleSave"><Icon name="{{ saved ? 'check' : 'heart' }}" /> {{ saved ? 'Saved' : 'Save' }}</Button>
        </View>
        <If condition="{{ reminderChoices.length > 0 || reminderChoice }}">
          <View grow>
            <Button variant="{{ reminderChoice ? 'secondary' : 'primary' }}" onClick="openReminderSheet"><Icon name="bell" /> {{ reminderChoice ? 'Reminder on' : 'Remind me' }}</Button>
          </View>
        </If>
      </View>
    </Footer>

    <Sheet open="{{ reminderSheetOpen }}" title="Remind me" showCloseIcon onClose="closeReminderSheet">
      <View gap="large">
        <Text tone="muted">{{ reminderChoice ? 'Set for ' + reminderWhen + '. Dash will send a notification that opens this event.' : 'Dash will send a notification that opens this event.' }}</Text>
        <RadioGroup value="{{ reminderChoice }}" onChange="setReminder">
          <For each="{{ reminderChoices }}" item="item" key="id">
            <Radio value="{{ item.id }}" label="{{ item.label }}" />
          </For>
        </RadioGroup>
        <If condition="{{ reminderChoice }}">
          <Button variant="secondary" onClick="removeReminder">Turn off reminder</Button>
        </If>
      </View>
    </Sheet>
  </ElseIf>
</View>
